#!/usr/bin/env python3
"""Search locally synchronized ORCD documentation."""

from __future__ import annotations

import argparse
import json
import math
import re
import sys
from collections import Counter
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_INDEX = ROOT / "docs" / "processed" / "orcd_docs.jsonl"
TOKEN_RE = re.compile(r"[A-Za-z0-9_+#.-]+")
STOPWORDS = {
    "a",
    "an",
    "and",
    "are",
    "can",
    "do",
    "for",
    "how",
    "i",
    "in",
    "is",
    "it",
    "me",
    "my",
    "of",
    "on",
    "or",
    "set",
    "should",
    "the",
    "to",
    "up",
    "what",
    "when",
    "where",
    "with",
}


def tokenize(text: str) -> list[str]:
    return [token.lower() for token in TOKEN_RE.findall(text)]


def query_tokens(query: str) -> list[str]:
    useful = [token for token in tokenize(query) if token not in STOPWORDS]
    return useful or tokenize(query)


def load_docs(path: Path) -> list[dict]:
    if not path.exists():
        raise FileNotFoundError(
            f"Documentation index not found at {path}. Run `python scripts/sync_docs.py` first."
        )
    docs = []
    with path.open("r", encoding="utf-8") as handle:
        for line in handle:
            if line.strip():
                docs.append(json.loads(line))
    return docs


def score_docs(query: str, docs: list[dict]) -> list[tuple[float, dict]]:
    query_terms = query_tokens(query)
    query_lower = query.lower()
    if not query_terms:
        return []

    doc_tokens = []
    doc_freq: Counter[str] = Counter()
    for doc in docs:
        weighted_text = " ".join(
            [
                str(doc.get("title", "")),
                str(doc.get("section", "")),
                str(doc.get("heading_path", "")),
                str(doc.get("text", "")),
                " ".join(doc.get("code_blocks", [])),
            ]
        )
        tokens = tokenize(weighted_text)
        doc_tokens.append(tokens)
        doc_freq.update(set(tokens))

    avg_len = sum(len(tokens) for tokens in doc_tokens) / max(len(doc_tokens), 1)
    scored = []
    for doc, tokens in zip(docs, doc_tokens):
        counts = Counter(tokens)
        length = max(len(tokens), 1)
        score = 0.0
        for term in query_terms:
            if not counts[term]:
                continue
            idf = math.log(1 + (len(docs) - doc_freq[term] + 0.5) / (doc_freq[term] + 0.5))
            tf = counts[term]
            score += idf * (tf * 2.2) / (tf + 1.2 * (1 - 0.75 + 0.75 * length / max(avg_len, 1)))

        heading_blob = " ".join([str(doc.get("title", "")), str(doc.get("section", ""))]).lower()
        code_blob = "\n".join(doc.get("code_blocks", [])).lower()
        text_blob = str(doc.get("text", "")).lower()
        all_blob = f"{heading_blob} {code_blob} {text_blob}"
        for term in query_terms:
            if term in heading_blob:
                score += 3.0
            if term in code_blob:
                score += 1.5
            if f" {term} " in f" {text_blob} ":
                score += 0.4
        if all(term in all_blob for term in query_terms):
            score += 2.0
        if all(term in heading_blob for term in query_terms):
            score += 4.0
        if "python" in query_terms and any(word in query_lower for word in ("set up", "setup", "install", "package", "environment")):
            if "miniforge" in all_blob or "module load" in all_blob:
                score += 5.0
            if "environment" in heading_blob or "conda" in heading_blob:
                score += 2.0
            if str(doc.get("source_path", "")).endswith("software/python.md"):
                score += 4.0
        if 80 <= len(text_blob) <= 1800:
            score += 0.5
        if score > 0:
            scored.append((score, doc))

    scored.sort(key=lambda item: item[0], reverse=True)
    return scored


def excerpt(text: str, terms: list[str], limit: int = 900) -> str:
    compact = re.sub(r"\s+", " ", text).strip()
    if len(compact) <= limit:
        return compact
    lowered = compact.lower()
    hit_positions = [lowered.find(term.lower()) for term in terms if lowered.find(term.lower()) >= 0]
    start = max(min(hit_positions) - 160, 0) if hit_positions else 0
    snippet = compact[start : start + limit].strip()
    prefix = "... " if start else ""
    suffix = " ..." if start + limit < len(compact) else ""
    return f"{prefix}{snippet}{suffix}"


def heading(doc: dict) -> str:
    path = doc.get("heading_path") or []
    if isinstance(path, list) and path:
        return " > ".join(path)
    if doc.get("section"):
        return f"{doc.get('title', 'Untitled')} > {doc['section']}"
    return str(doc.get("title", "Untitled"))


def format_result(index: int, doc: dict, terms: list[str]) -> str:
    parts = [f"[{index}] {heading(doc)}", "", excerpt(str(doc.get("text", "")), terms)]
    code_blocks = [block.strip() for block in doc.get("code_blocks", []) if block.strip()]
    if code_blocks:
        parts.extend(["", "Commands:"])
        for block in code_blocks[:2]:
            for line in block.splitlines()[:10]:
                parts.append(f"  {line}")
    if doc.get("url"):
        parts.extend(["", "Source:", str(doc["url"])])
    return "\n".join(parts).strip()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Search locally synchronized ORCD docs.")
    parser.add_argument("query", nargs="+", help="Search question or keywords.")
    parser.add_argument("--index", type=Path, default=DEFAULT_INDEX, help="Path to JSONL documentation index.")
    parser.add_argument("--limit", type=int, default=5, help="Maximum results to show.")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    query = " ".join(args.query)
    try:
        docs = load_docs(args.index)
    except FileNotFoundError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    results = score_docs(query, docs)[: max(args.limit, 1)]
    if not results:
        print(f"No local ORCD docs matched: {query}")
        return 1

    terms = query_tokens(query)
    print("\n\n".join(format_result(i, doc, terms) for i, (_, doc) in enumerate(results, start=1)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
